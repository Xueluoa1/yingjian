<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="映间服务端" Width="1080" Height="790" MinWidth="980" MinHeight="740"
        Background="#EEF2F4" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#182125"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#F0F4F5"/><Setter Property="Foreground" Value="#182125"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="20,12"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBody" Background="{TemplateBinding Background}" CornerRadius="19" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBody" Property="Opacity" Value=".78"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBody" Property="BorderBrush" Value="#20A880"/><Setter TargetName="ButtonBody" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBody" Property="Opacity" Value=".38"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#F1F4F6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,11"/>
      <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#182125"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="11">
          <ScrollViewer x:Name="PART_ContentHost"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#20A880"/><Setter TargetName="Box" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#F1F4F6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,11"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
        <Border x:Name="PasswordBody" Background="{TemplateBinding Background}" CornerRadius="11"><ScrollViewer x:Name="PART_ContentHost"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PasswordBody" Property="BorderBrush" Value="#20A880"/><Setter TargetName="PasswordBody" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Background="#EEF2F4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#FFFFFF" CornerRadius="0,26,26,0" Padding="24,34,20,22">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Border Background="#B9F3E4" CornerRadius="12" Width="42" Height="42">
              <Canvas Width="25" Height="25">
                <Rectangle Canvas.Top="3" Canvas.Left="2" Width="21" Height="8" RadiusX="2" RadiusY="2" Stroke="#173D32" StrokeThickness="1.7"/>
                <Rectangle Canvas.Top="14" Canvas.Left="2" Width="21" Height="8" RadiusX="2" RadiusY="2" Stroke="#173D32" StrokeThickness="1.7"/>
                <Ellipse Canvas.Top="6" Canvas.Left="6" Width="2.5" Height="2.5" Fill="#173D32"/>
                <Ellipse Canvas.Top="17" Canvas.Left="6" Width="2.5" Height="2.5" Fill="#173D32"/>
              </Canvas>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="映间" FontSize="22" FontWeight="Bold"/><TextBlock Text="服务端" FontSize="10" Foreground="#7E8B98" Margin="1,2,0,0"/></StackPanel>
          </StackPanel>
          <TextBlock Text="家庭影音 · 局域网" FontSize="11" Foreground="#8793A0" Margin="1,14,0,30"/>
          <Button x:Name="LocalTab" Content="本机服务" Background="#B9F3E4" HorizontalContentAlignment="Left" Margin="0,0,0,10"/>
          <Button x:Name="NasTab" Content="NAS 部署" Background="White" HorizontalContentAlignment="Left"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Background="#F3F6F7" CornerRadius="16" Padding="15" Margin="0,0,0,18">
            <StackPanel><TextBlock Text="管理家里的服务" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="片源、设备和连接码&#10;在管理页中设置。" FontSize="11" Foreground="#8793A0" LineHeight="20" Margin="0,7,0,0"/></StackPanel>
          </Border>
          <Button x:Name="ExitButton" Content="退出启动器" Background="#FFFFFF" Foreground="#7E8B98" Padding="12,10"/>
        </StackPanel>
        <Grid/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="34,33,34,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,24">
        <TextBlock x:Name="PageTitle" Text="家里的影音服务" FontSize="27" FontWeight="Bold"/>
        <TextBlock x:Name="PageSubtitle" Text="在这台电脑上运行，供局域网内的设备连接。" Foreground="#8793A0" Margin="0,9,0,0"/>
      </StackPanel>
      <Grid x:Name="LocalPanel" Grid.Row="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" CornerRadius="24" Padding="27,20" Margin="0,0,0,16">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="WINDOWS 服务端" Foreground="#8793A0" FontSize="10" DockPanel.Dock="Top" Margin="0,0,0,16"/>
              <Border x:Name="StateDot" Width="10" Height="10" CornerRadius="5" Background="#A4AEB5" Margin="0,0,12,0"/>
              <TextBlock x:Name="StateLabel" Text="正在检测服务" FontSize="24" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBlock x:Name="StateDetail" Text="正在检查本机服务状态…" Foreground="#7E8B98" Margin="0,11,0,16"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="StartButton" Content="启动服务" Background="#B9F3E4" Margin="0,0,10,0"/>
              <Button x:Name="StopButton" Content="停止" IsEnabled="False" Margin="0,0,10,0"/>
              <Button x:Name="RestartButton" Content="重启" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="VersionText" Text="局域网模式 · 数据保存在本机" Foreground="#8793A0" FontSize="11" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="White" CornerRadius="24" Padding="27,23" Margin="0,0,0,16">
          <StackPanel>
            <DockPanel Margin="0,0,0,12"><TextBlock Text="连接到这台电脑" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="同一个 Wi-Fi / 局域网" Foreground="#8793A0" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="AddressText" IsReadOnly="True" Text="服务启动后显示局域网地址" FontFamily="Consolas, Microsoft YaHei UI" VerticalContentAlignment="Center"/>
              <Button x:Name="CopyButton" Grid.Column="1" Content="复制地址" Margin="10,0,0,0" IsEnabled="False"/>
            </Grid>
            <TextBlock x:Name="AddressHelp" Text="手机扫码或输入链接，电视输入地址和连接码。" Foreground="#8793A0" FontSize="11" Margin="0,10,0,12"/>
            <Button x:Name="AdminButton" Content="打开管理页  ↗" Background="#182125" Foreground="White" HorizontalAlignment="Left" IsEnabled="False"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="White" CornerRadius="24" Padding="27,19" VerticalAlignment="Top">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="服务端口" VerticalAlignment="Center" Margin="0,0,15,0"/>
              <TextBox x:Name="PortInput" Grid.Column="1" Text="8080" MaxLength="5" FontFamily="Consolas" FontSize="13" Padding="12,8" AutomationProperties.Name="本机服务端口"/>
              <Button x:Name="LogButton" Grid.Column="3" Content="查看日志" Padding="15,9"/>
            </Grid>
            <DockPanel Margin="0,13,0,0">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ChangeDataButton" Content="选择目录" Padding="13,6" FontSize="11" Margin="0,0,5,0"/><Button x:Name="DataButton" Content="打开" Padding="13,6" FontSize="11"/></StackPanel>
              <StackPanel><TextBlock Text="数据文件夹 · 升级可选择原目录" Foreground="#8793A0" FontSize="10"/><TextBlock x:Name="DataPath" Foreground="#65727B" FontSize="10" Margin="0,4,12,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>
        </Grid>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="NasPanel" Grid.Row="1" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Background="White" CornerRadius="24" Padding="28,25" VerticalAlignment="Top">
          <StackPanel>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="NAS 架构" VerticalAlignment="Center" Margin="0,0,16,0"/>
              <ComboBox x:Name="NasArchitecture" Grid.Column="1" SelectedIndex="0" Padding="10,8" FontSize="13" Background="#F1F4F6" BorderThickness="0" AutomationProperties.Name="NAS 处理器架构">
                <ComboBoxItem Tag="amd64" Content="AMD64 / x86-64 · Intel、AMD"/>
                <ComboBoxItem Tag="arm64" Content="ARM64 / aarch64 · 64 位 ARM"/>
              </ComboBox>
            </Grid>
            <TextBlock x:Name="NasMode" Text="源码部署 · 需要联网构建" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock x:Name="NasHelp" Text="当前包未附带完整镜像。NAS 需要下载 Node 镜像和依赖，再构建服务；具备离线镜像的发行版会显示离线导出。" Foreground="#8793A0" Margin="0,9,0,22" LineHeight="21"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="NAS 局域网地址" Margin="0,0,0,8"/><TextBox x:Name="NasIp" Text="192.168.1.20" MaxLength="15" AutomationProperties.Name="NAS 局域网地址"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="访问端口" Margin="0,0,0,8"/><TextBox x:Name="NasPort" Text="8080" MaxLength="5" AutomationProperties.Name="NAS 访问端口"/></StackPanel>
            </Grid>
            <TextBlock Text="管理密码" Margin="0,18,0,8"/>
            <PasswordBox x:Name="NasPassword" MaxLength="128" AutomationProperties.Name="NAS 管理密码"/>
            <TextBlock Text="12–128 个英文字符、数字或符号；不使用引号和反斜杠。" Foreground="#8793A0" FontSize="11" Margin="0,7,0,0"/>
            <TextBlock Text="已有数据卷名称（可选）" Margin="0,18,0,8"/>
            <TextBox x:Name="NasVolume" MaxLength="128" AutomationProperties.Name="已有数据卷名称"/>
            <TextBlock Text="首次部署留空即可。升级时填写 NAS 上原有数据卷的准确名称，以保留片源和记录。" Foreground="#8793A0" FontSize="11" Margin="0,7,0,18" LineHeight="19"/>
            <Border Background="#F0F8F5" CornerRadius="14" Padding="15,12" Margin="0,0,0,20">
              <TextBlock x:Name="NasContents" Text="导出源码、Compose 和配置。管理密码保存在包内 .env，请妥善保存。" Foreground="#4F7668" FontSize="11" LineHeight="20"/>
            </Border>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ExportButton" Content="导出源码部署包" Background="#B9F3E4" Margin="0,0,10,0"/>
              <Button x:Name="ExportFolderButton" Content="打开文件夹" Visibility="Collapsed"/>
            </StackPanel>
          </StackPanel>
        </Border>
        </ScrollViewer>
      </Grid>
      <Border x:Name="LogPanel" Grid.Row="1" Background="#FFFFFF" CornerRadius="24" Padding="24" Visibility="Collapsed">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button x:Name="CloseLogButton" DockPanel.Dock="Right" Content="返回" Padding="15,8"/>
            <StackPanel><TextBlock Text="服务日志" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="显示本次启动器运行期间的记录。" Foreground="#8793A0" FontSize="11" Margin="0,7,0,0"/></StackPanel>
          </DockPanel>
          <TextBox x:Name="Logs" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Background="#F4F7F8"/>
        </DockPanel>
      </Border>
      <TextBlock x:Name="Notice" Grid.Row="2" Foreground="#53746A" FontSize="11" Margin="2,15,0,0" MinHeight="30" LineHeight="18"/>
    </Grid>
  </Grid>
</Window>
