# Copy this file to .env, or export a configured bundle from the Windows server launcher.
# Use single quotes around the password; no apostrophe, backslash, or control characters.
ADMIN_PASSWORD='replace-with-your-own-password'
LAN_BIND_IP=192.168.1.100
HOST_PORT=8080
PUBLIC_ORIGIN=http://192.168.1.100:8080
# Upgrading from the older Compose package? deploy.sh detects the existing volume.
# With a NAS GUI importer, fill in the exact previous /app/data volume name instead.
DATA_VOLUME=yingjian-data
# Optional: use the exact Node.js image reference that your NAS can access.
# Changing this does not bypass registry authentication or download failures.
NODE_IMAGE=public.ecr.aws/docker/library/node:24-alpine
