# Copy to .env and fill in the NAS LAN address, port, and your own password.
# Existing installations: retain the original .env and its actual data volume.
# Password: 12-128 characters; single quotes allowed only around the whole value.
ADMIN_PASSWORD='replace-with-your-own-password'
LAN_BIND_IP=192.168.1.100
HOST_PORT=8080
PUBLIC_ORIGIN=http://192.168.1.100:8080
DATA_VOLUME=yingjian-data
# NODE_IMAGE from an older source bundle is accepted but ignored.
# This bundle runs the included application image; no base image is downloaded.
