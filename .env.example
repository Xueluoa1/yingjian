# NAS only: change this before deployment. Never expose this service on the public Internet.
ADMIN_PASSWORD=replace-with-your-own-long-password
# Set your NAS LAN origin so pairing links point to the host instead of Docker's private IP.
PUBLIC_ORIGIN=http://192.168.1.100:8080
# Optional: restrict published port to the NAS LAN IP.
# LAN_BIND_IP=192.168.1.100
# Optional: override the Node.js base image used for Docker builds.
NODE_IMAGE=public.ecr.aws/docker/library/node:24-alpine
